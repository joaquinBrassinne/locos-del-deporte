{
  "name": "crazysports-tests",
  "private": true,
  "description": "Tareas de prueba de API (Postman/Newman) de Locos del Deporte",
  "scripts": {
    "test:api": "newman run tests/postman/CrazySports.postman_collection.json -e tests/postman/entorno-local.postman_environment.json -r cli,htmlextra --reporter-htmlextra-export tests/postman/reports/reporte.html",
    "test:e2e": "playwright test -c tests/e2e",
    "test:e2e:report": "playwright show-report tests/e2e/playwright-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "newman": "^6.2.1",
    "newman-reporter-htmlextra": "^1.23.1",
    "typescript": "^7.0.2"
  }
}
